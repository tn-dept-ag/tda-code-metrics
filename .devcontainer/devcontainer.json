{
  "name": "Python Development",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "DavidAnson.vscode-markdownlint",
        "EditorConfig.EditorConfig"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y cloc && python -m pip install --upgrade pip && pip install ruff pre-commit"
}
